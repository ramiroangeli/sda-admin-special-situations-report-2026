# Copy this file to .env.local (local dev) or set these as Environment
# Variables in the Vercel project dashboard (production). Never commit the
# real values — .env / .env.local are gitignored.

# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings → API → "service_role" secret key. Server-only — this key
# bypasses Row Level Security, so it must NEVER be exposed to the browser
# (it is only read in src/lib/supabaseServer.js and API routes, never in a
# NEXT_PUBLIC_ variable, never sent to the client).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Access control ──────────────────────────────────────────────────────
# A long, random shared secret that gates the whole app (see README.md
# "Access / security"). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Give Steve the resulting review link — https://your-app.vercel.app/?token=<this value>
# — once. The app then sets a long-lived httpOnly cookie so he never has to
# re-enter it. Do NOT reuse a short or guessable value.
REVIEW_ACCESS_TOKEN=replace-with-a-long-random-value

# Optional second token for local QA/dry-run testing (see QA_ACCEPTANCE_TEST.md).
# If unset, REVIEW_ACCESS_TOKEN is used for QA too.
QA_ACCESS_TOKEN=replace-with-a-different-long-random-value
